# PLACEHOLDERS ONLY — Copy sang apps/worker/.dev.vars khi chạy local (đã gitignore)
ENVIRONMENT=development
GEMINI_API_KEY=replace_with_local_test_key
GEMINI_MODEL=models/gemini-3.8-live
TELEGRAM_BOT_TOKEN=replace_with_test_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_alphanumeric_secret
